@page "/"
@inject ProPairApi Api
@inject NavigationManager Nav

<PageTitle>ProPair – Choose tournament</PageTitle>

<h1>Choose a tournament</h1>
<p class="muted">Team tournaments from New Recruit (The 9th Age), updated daily.</p>

@if (_tournaments is null)
{
    <p>Loading…</p>
}
else
{
    <input class="search" type="search" placeholder="Search…" @bind="_query" @bind:event="oninput" />
    <div class="cards">
        @foreach (var t in Filtered(upcoming: true))
        {
            <TournamentCard Tournament="t" Disabled="_busy" OnClick="() => Open(t.Id)" />
        }
    </div>
    @if (Filtered(upcoming: false).Any())
    {
        <details class="past">
            <summary>Past tournaments</summary>
            <div class="cards">
                @foreach (var t in Filtered(upcoming: false))
                {
                    <TournamentCard Tournament="t" Disabled="_busy" OnClick="() => Open(t.Id)" />
                }
            </div>
        </details>
    }
}

@if (_demos is { Count: > 0 })
{
    <h2>Try a demo</h2>
    <div class="cards">
        @foreach (var d in _demos)
        {
            <button class="card" disabled="@_busy" @onclick="() => ImportDemoAsync(d.ExternalId)">
                <strong>@d.Name</strong>
                <span class="muted">Invented teams and lists</span>
            </button>
        }
    </div>
}

@if (_error is not null)
{
    <p class="error">@_error</p>
}

@code {
    private IReadOnlyList<TournamentSummaryDto>? _tournaments;
    private IReadOnlyList<SourceTournamentDto>? _demos;
    private string _query = "";
    private bool _busy;
    private string? _error;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Now);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _tournaments = (await Api.GetTournamentsAsync()).Where(t => !t.IsDemo).ToList();
            _demos = await Api.GetSourceTournamentsAsync();
        }
        catch (ApiException e) { _error = e.Message; }
    }

    /// <summary>Upcoming: soonest first. Past: most recent first.</summary>
    private IEnumerable<TournamentSummaryDto> Filtered(bool upcoming)
    {
        var hits = (_tournaments ?? [])
            .Where(t => _query.Length == 0 || t.Name.Contains(_query, StringComparison.OrdinalIgnoreCase))
            .Where(t => ((t.EndDate ?? t.StartDate ?? Today) >= Today) == upcoming);
        return upcoming ? hits.OrderBy(t => t.StartDate) : hits.OrderByDescending(t => t.StartDate);
    }

    private void Open(Guid id) => Nav.NavigateTo(Routes.Tournament(id));

    private Task ImportDemoAsync(string externalId) => RunAsync(async () =>
    {
        var imported = await Api.ImportAsync(externalId);
        Open(imported.Id);
    });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try { await action(); }
        catch (ApiException e) { _error = e.Message; }
        finally { _busy = false; }
    }
}
