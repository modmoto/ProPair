@page "/preparation/{Token}"
@inject ProPairApi Api
@inject NavigationManager Nav
@inject WhoAmI Me

<PageTitle>ProPair – @_prep?.TournamentName</PageTitle>

@if (_error is not null)
{
    <p class="error">@_error</p>
}
else if (_prep is null)
{
    <p>Loading…</p>
}
else
{
    <h1>@_prep.TournamentName</h1>
    <p class="muted">@_prep.Own.Name · @_prep.TeamSize v @_prep.TeamSize @(_prep.CanEdit ? "" : "· read only")</p>
    <NewRecruitStatus TournamentId="_prep.TournamentId" ListsVisible="_prep.ListsVisible" IsDemo="_prep.IsDemo"
                LastSyncedAt="_prep.LastSyncedAt" OnSynced="LoadAsync" />
    <RosterWarning Team="_prep.Own" ShowName="true" />
    @if (_prep.CanEdit)
    {
        <MePicker Players="_prep.Own.Players" Selected="_me" OnSelect="SelectMeAsync" />
    }

    <section class="share">
        <h2>Share</h2>
        @if (_prep.EditToken is not null)
        {
            <ShareLink Label="Edit" Url="@LinkFor(_prep.EditToken)" />
        }
        <ShareLink Label="Read only" Url="@LinkFor(_prep.ReadToken)" />
    </section>

    <h2>Opponents</h2>
    @if (Locked)
    {
        <p class="muted">Pick who you are above, then you can open the opponents.</p>
    }
    <div class="cards">
        @foreach (var o in _prep.Opponents)
        {
            var total = _prep.Own.Players.Count * o.Participant.Players.Count;
            <a class="card @(Locked ? "locked" : "")" href="@(Locked ? null : Routes.Matrix(Token, o.Participant.Id))" aria-disabled="@Locked">
                <strong>@o.Participant.Name</strong>
                <span class="armies">
                    @foreach (var pl in o.Participant.Players)
                    {
                        <span class="army" title="@pl.ArmyName">@pl.ArmyShort</span>
                    }
                </span>
                @if (total == 0)
                {
                    <span class="muted">No lists known yet</span>
                }
                else
                {
                    <span class="progress"><span style="width:@(100 * o.RatedCells / total)%"></span></span>
                    <span class="muted">@o.RatedCells / @total rated</span>
                }
                <RosterWarning Team="o.Participant" />
            </a>
        }
    </div>
}

@code {
    [Parameter] public string Token { get; set; } = "";

    private PreparationDto? _prep;
    private string? _error;
    private PlayerDto? _me;

    /// <summary>Editing needs to know who you are before you can open an opponent.</summary>
    private bool Locked => _prep!.CanEdit && _me is null;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _prep = await Api.GetPreparationAsync(Token);
            var meId = await Me.GetAsync(_prep.Own.Id);
            _me = _prep.Own.Players.FirstOrDefault(p => p.Id == meId);
        }
        catch (ApiException e) { _error = e.Message; }
    }

    private async Task SelectMeAsync(PlayerDto player)
    {
        _me = player;
        await Me.SetAsync(_prep!.Own.Id, player.Id);
    }

    private string LinkFor(string token) => Nav.ToAbsoluteUri(Routes.Preparation(token)).ToString();
}
