@page "/vorbereitung/{Token}/gegner/{OpponentId:guid}"
@implements IDisposable
@inject ProPairApi Api
@inject WhoAmI Me
@inject IJSRuntime Js

<PageTitle>ProPair – @_matrix?.Own.Name vs @_matrix?.Opponent.Name</PageTitle>

@if (_error is not null)
{
    <p class="error">@_error</p>
}
@if (_matrix is null)
{
    <p>Lade…</p>
}
else
{
    <a class="link" href="@Routes.Preparation(Token)">← @_matrix.TournamentName</a>
    <div class="titlebar">
        <h1>@_matrix.Own.Name <span class="muted">vs</span> @_matrix.Opponent.Name</h1>
        <a class="pill" href="@Routes.Pairing(Token, OpponentId)">Pairing →</a>
    </div>
    <RosterWarning Team="_matrix.Own" ShowName="true" />
    <RosterWarning Team="_matrix.Opponent" ShowName="true" />
    @if (_matrix.CanEdit)
    {
        <MePicker Players="_matrix.Own.Players" Selected="_me" OnSelect="SelectMeAsync" />
    }
    @if (_matrix.IsDemo && _matrix.CanEdit && _cells.Count < _matrix.Own.Players.Count * _matrix.Opponent.Players.Count)
    {
        <button class="btn" @onclick="FillDemoAsync">Demo-Werte füllen</button>
    }
    @if (_matrix.Own.Players.Concat(_matrix.Opponent.Players).Any(ListReset))
    {
        <p class="list-changed-hint muted"><i class="list-changed">i</i> Neue Liste aus New Recruit – Bewertungen und Notizen für diesen Spieler starten neu.</p>
    }

    <div class="matrix-wrap settle" @ref="_grid">
        <table class="matrix">
            <thead>
            <tr>
                <th class="corner"></th>
                @foreach (var opp in _matrix.Opponent.Players)
                {
                    <th>
                        <button class="@(_shown is null && CurrentOpp == opp ? "active" : "") @(HasPlayerNote(opp.Id) ? "has-note" : "")"
                                title="Liste & Notiz" @onclick="() => ShowOpponent(opp)">
                            <span class="army">@opp.ArmyShort</span>
                            <span class="player">@opp.Name</span>
                            @if (ListReset(opp))
                            {
                                <i class="list-changed" title="Liste am @opp.ListChangedAt?.ToLocalTime().ToString("dd.MM.") geändert">i</i>
                            }
                        </button>
                    </th>
                }
            </tr>
            </thead>
            <tbody>
            @foreach (var own in _matrix.Own.Players)
            {
                var isMe = own.Id == _me?.Id;
                <tr class="@(isMe ? "me" : "")">
                    <th class="row">
                        <button class="@(_shown == own ? "active" : "") @(HasPlayerNote(own.Id) ? "has-note" : "")"
                                title="Liste & Notiz" @onclick="() => ShowOwn(own)">
                            <span class="army">@own.ArmyShort</span>
                            <span class="player">@own.Name</span>
                            @if (ListReset(own))
                            {
                                <i class="list-changed" title="Liste am @own.ListChangedAt?.ToLocalTime().ToString("dd.MM.") geändert">i</i>
                            }
                        </button>
                    </th>
                    @foreach (var opp in _matrix.Opponent.Players)
                    {
                        var level = LevelAt(own.Id, opp.Id);
                        var open = _sheet == (own.Id, opp.Id) || _quick == (own.Id, opp.Id);
                        var current = isMe && _shown is null && CurrentOpp == opp;
                        <td style="background:@(level?.Color ?? "transparent")" data-own="@own.Id" data-opp="@opp.Id"
                            class="@(_cellNotes.ContainsKey((own.Id, opp.Id)) ? "has-note" : "") @(open ? "sheet-open" : "") @(current ? "current" : "")">
                            @if (CanEditNow)
                            {
                                <button class="cellbtn" aria-label="@own.Name gegen @opp.Name bewerten"
                                        @onclick="() => _quick = (own.Id, opp.Id)">@level?.Label</button>
                            }
                            else
                            {
                                <span>@level?.Label</span>
                            }
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="legend">
        @foreach (var l in _matrix.Scale)
        {
            <span style="background:@l.Color">@l.Label</span>
        }
    </div>
    <p class="subtle">Lange drücken oder Rechtsklick auf ein Feld: Notiz &amp; Verlauf.</p>

    @if (_shown is not null)
    {
        @* a teammate's list replaces the carousel until it is closed *@
        var shown = _shown;
        <ListPanel @key="shown.Id" Player="shown" Marks="MarksFor(shown.Id)" Note="PlayerNote(shown.Id)"
                   CanEdit="_matrix.CanEdit" HasAuthor="HasAuthor" OnClose="() => _shown = null"
                   OnSaveNote="text => SavePlayerNoteAsync(shown.Id, text)"
                   OnMark="m => SaveListMarkAsync(shown.Id, m)" />
    }
    else if (CurrentOpp is { } opp)
    {
        var players = _matrix.Opponent.Players;
        var mine = _me is null ? null : LevelAt(_me.Id, opp.Id);
        @* swipe left/right (or the arrows) through the opponent lists *@
        <section class="listview opplists" @ontouchstart="TouchStart" @ontouchend="TouchEnd">
            <div class="listnav">
                <button class="btn" aria-label="Vorherige Liste" disabled="@(players.Count < 2)" @onclick="() => MoveList(-1)">‹</button>
                <span class="dots">
                    @for (var i = 0; i < players.Count; i++)
                    {
                        var index = i;
                        @* my rating against them as colour: shows at a glance what is still missing *@
                        var rated = _me is null ? null : LevelAt(_me.Id, players[index].Id);
                        <button class="dot @(index == _listIndex ? "on" : "") @(rated is null ? "" : "rated")"
                                style="@(rated is null ? null : $"background:{rated.Color}")" aria-label="@players[index].Name"
                                @onclick="() => _listIndex = index">@players[index].ArmyShort</button>
                    }
                </span>
                <button class="btn" aria-label="Nächste Liste" disabled="@(players.Count < 2)" @onclick="() => MoveList(1)">›</button>
            </div>
            <div class="settle" @key="opp.Id">
                <header class="opphead">
                    <span class="army">@opp.ArmyShort</span>
                    <strong>@opp.Name</strong>
                    <span class="muted">@opp.ArmyName</span>
                </header>
                @if (_me is not null)
                {
                    var me = _me;
                    <div class="sheet-levels">
                        @foreach (var l in _matrix.Scale)
                        {
                            <button class="lvl @(mine?.Key == l.Key ? "on" : "")" style="background:@l.Color"
                                    disabled="@(!CanEditNow)" @onclick="() => SetAsync(me.Id, opp.Id, l.Key)">@l.Label</button>
                        }
                        <button class="lvl clear" disabled="@(!CanEditNow || mine is null)" title="Bewertung löschen"
                                aria-label="Bewertung löschen" @onclick="() => SetAsync(me.Id, opp.Id, null)"><TrashIcon /></button>
                    </div>
                    <p class="subtle">Deine Bewertung: @me.Name gegen @opp.Name</p>
                }
                <ListPanel Player="opp" Marks="MarksFor(opp.Id)" Note="PlayerNote(opp.Id)"
                           CanEdit="_matrix.CanEdit" HasAuthor="HasAuthor"
                           OnSaveNote="text => SavePlayerNoteAsync(opp.Id, text)"
                           OnMark="m => SaveListMarkAsync(opp.Id, m)" />
            </div>
        </section>
    }

    @if (_quick is var (quickOwn, quickOpp))
    {
        var qOwn = Player(quickOwn);
        var qOpp = Player(quickOpp);
        var qLevel = LevelAt(quickOwn, quickOpp);
        <div class="sheet-backdrop" @onclick="() => _quick = null"></div>
        <section class="sheet quick" role="dialog" aria-label="Bewerten">
            <header>
                <strong><span class="army">@qOwn.ArmyShort</span> @qOwn.Name <span class="muted">vs</span> <span class="army">@qOpp.ArmyShort</span> @qOpp.Name</strong>
                <button class="x" aria-label="Schließen" @onclick="() => _quick = null">✕</button>
            </header>
            <div class="sheet-levels">
                @foreach (var l in _matrix.Scale)
                {
                    <button class="lvl @(qLevel?.Key == l.Key ? "on" : "")" style="background:@l.Color"
                            @onclick="() => QuickSetAsync(quickOwn, quickOpp, l.Key)">@l.Label</button>
                }
                <button class="lvl clear" disabled="@(qLevel is null)" title="Bewertung löschen" aria-label="Bewertung löschen"
                        @onclick="() => QuickSetAsync(quickOwn, quickOpp, null)"><TrashIcon /></button>
            </div>
            <button class="link subtle" @onclick="() => OpenSheet(quickOwn, quickOpp)">Notiz &amp; Verlauf</button>
        </section>
    }

    @if (_sheet is var (sheetOwn, sheetOpp))
    {
        var own = Player(sheetOwn);
        var opp = Player(sheetOpp);
        var current = LevelAt(sheetOwn, sheetOpp);
        <div class="sheet-backdrop" @onclick="CloseSheet"></div>
        <section class="sheet" role="dialog" aria-label="Matchup">
            <header>
                <strong><span class="army">@own.ArmyShort</span> @own.Name <span class="muted">vs</span> <span class="army">@opp.ArmyShort</span> @opp.Name</strong>
                <button class="x" aria-label="Schließen" @onclick="CloseSheet">✕</button>
            </header>

            <div class="sheet-levels">
                @foreach (var l in _matrix.Scale)
                {
                    <button class="lvl @(current?.Key == l.Key ? "on" : "")" style="background:@l.Color"
                            disabled="@(!CanEditNow)" @onclick="() => SetAsync(sheetOwn, sheetOpp, l.Key)">@l.Label</button>
                }
                <button class="lvl clear" disabled="@(!CanEditNow || current is null)" title="Bewertung löschen"
                        aria-label="Bewertung löschen" @onclick="() => SetAsync(sheetOwn, sheetOpp, null)"><TrashIcon /></button>
            </div>

            <h3>Notiz</h3>
            <NoteEditor Note="CellNote(sheetOwn, sheetOpp)" CanEdit="_matrix.CanEdit" HasAuthor="HasAuthor"
                        Placeholder="Notiz zum Matchup, z. B. Szenario, Gelände …" OnSave="text => SaveCellNoteAsync(sheetOwn, sheetOpp, text)" />

            @if (_history is null)
            {
                <button class="link subtle" @onclick="LoadHistoryAsync">Verlauf anzeigen</button>
            }
            else
            {
                <h3>Verlauf</h3>
                @if (_history.Count == 0)
                {
                    <p class="muted">Noch keine Änderungen.</p>
                }
                <ul class="history">
                    @foreach (var h in _history)
                    {
                        <li>
                            <span class="muted">@Format.When(h.At)</span>
                            <span>@h.Author</span>
                            <span class="change">@Label(h.OldLevelKey) → @Label(h.NewLevelKey)</span>
                        </li>
                    }
                </ul>
            }
        </section>
    }
}

@code {
    [Parameter] public string Token { get; set; } = "";
    [Parameter] public Guid OpponentId { get; set; }

    private MatrixDto? _matrix;
    private Dictionary<(Guid, Guid), string> _cells = [];
    private Dictionary<(Guid, Guid), NoteDto> _cellNotes = [];
    private Dictionary<Guid, NoteDto> _playerNotes = [];
    private PlayerDto? _me;
    private string? _error;
    private PlayerDto? _shown;               // a teammate's list, opened from the row header
    private int _listIndex;                  // opponent list shown in the carousel
    private double? _touchX;
    private (Guid Own, Guid Opp)? _quick;    // rating flyout of a tapped cell
    private (Guid Own, Guid Opp)? _sheet;    // notes & history of a long-pressed cell
    private IReadOnlyList<RatingChangeDto>? _history;
    private readonly SemaphoreSlim _writeQueue = new(1, 1); // keep edits in order, one request at a time

    private ElementReference _grid;
    private DotNetObjectReference<Matrix>? _self;
    private bool _longPressReady;

    /// <summary>The chosen player of the own team is the author of every change.</summary>
    private string? Author => _me?.Name;
    private bool HasAuthor => _me is not null;
    private bool CanEditNow => _matrix!.CanEdit && HasAuthor;

    private PlayerDto? CurrentOpp => _matrix!.Opponent.Players.ElementAtOrDefault(_listIndex);

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
        if (_matrix is null) return;
        var meId = await Me.GetAsync(_matrix.Own.Id);
        _me = _matrix.Own.Players.FirstOrDefault(p => p.Id == meId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_matrix is null || _longPressReady) return;
        _longPressReady = true;
        _self = DotNetObjectReference.Create(this);
        try { await Js.InvokeVoidAsync("proPair.longPress", _grid, _self); }
        catch (JSException) { /* script missing: the matrix still works, only the sheet is unreachable */ }
    }

    [JSInvokable]
    public async Task OnCellLongPress(string own, string opp)
    {
        OpenSheet(Guid.Parse(own), Guid.Parse(opp));
        StateHasChanged();
        await Task.CompletedTask;
    }

    private void OpenSheet(Guid own, Guid opp)
    {
        _quick = null;
        _sheet = (own, opp);
        _history = null;
    }

    private void CloseSheet()
    {
        _sheet = null;
        _history = null;
    }

    private async Task QuickSetAsync(Guid own, Guid opp, string? key)
    {
        _quick = null;
        await SetAsync(own, opp, key);
    }

    private void ShowOwn(PlayerDto player) => _shown = _shown == player ? null : player;

    /// <summary>An opponent's header shows their list in the carousel (and closes a teammate's list).</summary>
    private void ShowOpponent(PlayerDto player)
    {
        _shown = null;
        _listIndex = Math.Max(_matrix!.Opponent.Players.ToList().IndexOf(player), 0);
    }

    private void MoveList(int delta)
    {
        var count = _matrix!.Opponent.Players.Count;
        if (count == 0) return;
        _listIndex = ((_listIndex + delta) % count + count) % count;
    }

    private void TouchStart(TouchEventArgs e) => _touchX = e.ChangedTouches.FirstOrDefault()?.ClientX;

    private void TouchEnd(TouchEventArgs e)
    {
        if (_touchX is not { } start || e.ChangedTouches.FirstOrDefault() is not { } end) return;
        var dx = end.ClientX - start;
        _touchX = null;
        if (Math.Abs(dx) < 50) return; // a tap or a scroll, not a swipe
        MoveList(dx < 0 ? 1 : -1);
    }

    private async Task SelectMeAsync(PlayerDto player)
    {
        _me = player;
        await Me.SetAsync(_matrix!.Own.Id, player.Id);
    }

    private async Task LoadHistoryAsync()
    {
        if (_sheet is not var (own, opp)) return;
        try { _history = await Api.GetCellHistoryAsync(Token, OpponentId, own, opp); }
        catch (ApiException e) { _error = e.Message; }
    }

    private async Task LoadAsync()
    {
        try
        {
            _matrix = await Api.GetMatrixAsync(Token, OpponentId);
            Apply(_matrix);
        }
        catch (ApiException e) { _error = e.Message; }
    }

    private void Apply(MatrixDto m)
    {
        _cells = m.Cells.ToDictionary(c => (c.OwnPlayerId, c.OpponentPlayerId), c => c.LevelKey);
        _cellNotes = m.CellNotes.ToDictionary(c => (c.OwnPlayerId, c.OpponentPlayerId), c => c.Note);
        _playerNotes = m.PlayerNotes.ToDictionary(n => n.PlayerId, n => n.Note);
    }

    private PlayerDto Player(Guid id) => _matrix!.Own.Players.Concat(_matrix.Opponent.Players).First(p => p.Id == id);

    /// <summary>The list changed in New Recruit and nothing is rated for this player yet.</summary>
    private bool ListReset(PlayerDto p) => p.ListChangedAt is not null && !_cells.Keys.Any(k => k.Item1 == p.Id || k.Item2 == p.Id);

    private RatingLevelDto? LevelAt(Guid own, Guid opp) =>
        _cells.TryGetValue((own, opp), out var key) ? _matrix!.Scale.FirstOrDefault(l => l.Key == key) : null;

    private string Label(string? key) => key is null ? "leer" : _matrix!.Scale.FirstOrDefault(l => l.Key == key)?.Label ?? key;

    private NoteDto? CellNote(Guid own, Guid opp) => _cellNotes.GetValueOrDefault((own, opp));
    private NoteDto? PlayerNote(Guid id) => _playerNotes.GetValueOrDefault(id);
    private bool HasPlayerNote(Guid id) => _playerNotes.ContainsKey(id) || _matrix!.ListMarks.Any(m => m.PlayerId == id);
    private IReadOnlyList<ListMarkDto> MarksFor(Guid id) => _matrix!.ListMarks.Where(m => m.PlayerId == id).ToList();

    private async Task SetAsync(Guid own, Guid opp, string? key)
    {
        if (!CanEditNow) return;
        key = string.IsNullOrEmpty(key) ? null : key;
        if (key is null) _cells.Remove((own, opp)); else _cells[(own, opp)] = key;
        await WriteAsync(() => Api.SetRatingAsync(Token, OpponentId, new SetRatingRequest(own, opp, key, Author!)));
        if (_history is not null) await LoadHistoryAsync();
    }

    private async Task SaveCellNoteAsync(Guid own, Guid opp, string text)
    {
        await WriteAsync(() => Api.SetCellNoteAsync(Token, OpponentId, own, opp, new SetNoteRequest(text, Author!)));
        await LoadAsync();
    }

    private async Task SavePlayerNoteAsync(Guid playerId, string text)
    {
        await WriteAsync(() => Api.SetPlayerNoteAsync(Token, playerId, new SetNoteRequest(text, Author!)));
        await LoadAsync();
    }

    private async Task SaveListMarkAsync(Guid playerId, (int LineIndex, string LineText, string? Color, string? Note) m)
    {
        await WriteAsync(() => Api.SetListMarkAsync(Token, playerId, m.LineIndex,
            new SetListMarkRequest(m.LineText, m.Color, m.Note, Author!)));
        await LoadAsync();
    }

    private async Task WriteAsync(Func<Task> write)
    {
        _error = null;
        await _writeQueue.WaitAsync();
        try { await write(); }
        catch (ApiException e)
        {
            _error = e.Message;
            await LoadAsync();
        }
        finally { _writeQueue.Release(); }
    }

    private async Task FillDemoAsync()
    {
        try
        {
            _matrix = await Api.FillDemoAsync(Token, OpponentId);
            Apply(_matrix);
        }
        catch (ApiException e) { _error = e.Message; }
    }

    public void Dispose() => _self?.Dispose();
}
