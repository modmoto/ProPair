@page "/p/{Token}"
@page "/p/{Token}/vs/{OpponentId:guid}"
@page "/p/{Token}/vs/{OpponentId:guid}/pairing"
@inject NavigationManager Nav

@* Links shared before the speaking URLs (/p/{token}/vs/{opponent}/pairing): forwarded, without a history entry. *@

@code {
    [Parameter] public string Token { get; set; } = "";
    [Parameter] public Guid? OpponentId { get; set; }

    protected override void OnParametersSet()
    {
        var pairing = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/').EndsWith("/pairing");
        var target = OpponentId is not { } opp ? Routes.Preparation(Token)
            : pairing ? Routes.Pairing(Token, opp)
            : Routes.Matrix(Token, opp);
        Nav.NavigateTo(target, replace: true);
    }
}
