@page "/p/{Token}/vs/{OpponentId:guid}/pairing"
@implements IDisposable
@inject ProPairApi Api
@inject Preferences Prefs

@*
    Live pairing, everything happens in the matrix:
    1. Defenders: tap our player (left), then theirs (top) → saved, both lines highlighted, rest greyed.
    2. Attackers: tap cells in our defender's row (their attackers) and in their defender's column (our attackers).
    3. Choice: tap which of their attackers we take (row) and which of ours they took (column).
    Paired players fade out and the matrix shrinks. Undo sits in the title bar: the one spot that never moves.
*@

<PageTitle>Pairing – @_p?.Own.Name vs @_p?.Opponent.Name</PageTitle>

@if (_p is null)
{
    @if (_error is not null) { <p class="error">@_error</p> } else { <p>Lade…</p> }
}
else
{
    <a class="link" href="p/@Token/vs/@OpponentId">← Matrix</a>
    <div class="titlebar">
        <h1>@_p.Own.Name <span class="muted">vs</span> @_p.Opponent.Name</h1>
        <button class="eye @(_showAdvice ? "on" : "")" @onclick="ToggleAdviceAsync" disabled="@_busy"
                title="@(_showAdvice ? "Empfehlungen ausblenden" : "Empfehlungen einblenden")"
                aria-label="@(_showAdvice ? "Empfehlungen ausblenden" : "Empfehlungen einblenden")" aria-pressed="@_showAdvice">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" />
                <circle cx="12" cy="12" r="3" />
                @if (!_showAdvice)
                {
                    <path d="M3 3l18 18" />
                }
            </svg>
        </button>
        <button class="enemy-toggle @(_enemyView ? "on" : "")" @onclick="() => _enemyView = !_enemyView"
                title="@(_enemyView ? "Zurück zu unserer Sicht" : "Gegner-Sicht: Bewertungen umgedreht")"
                aria-label="Gegner-Sicht" aria-pressed="@_enemyView">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 7h14" /><path d="M14 3l4 4-4 4" />
                <path d="M20 17H6" /><path d="M10 13l-4 4 4 4" />
            </svg>
        </button>
        <span class="total @TotalClass" title="Summe der festen Matchups (@_p.Games.Count/@_p.Own.Players.Count)">
            <strong>@Format.Score(_p.FixedScore)</strong>
            <small>@_p.Games.Count/@_p.Own.Players.Count</small>
        </span>
        @if (_p.CanEdit)
        {
            <button class="undo" disabled="@(_busy || _p.MoveCount == 0 && !HasLocalPick)" @onclick="UndoAsync"
                    title="Rückgängig" aria-label="Rückgängig">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 14 4 9l5-5" />
                    <path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11" />
                </svg>
            </button>
        }
    </div>

    @if (_local is not null && _p.CanEdit)
    {
        <p class="sync @_local.Status.ToString().ToLowerInvariant()">@SyncText</p>
    }

    <div class="viewtabs" role="tablist" aria-label="Ansicht">
        <button role="tab" class="@(_listView ? "" : "on")" aria-selected="@(!_listView)" @onclick="() => _listView = false">Matrix</button>
        <button role="tab" class="@(_listView ? "on" : "")" aria-selected="@_listView" @onclick="ShowLists">Listen</button>
    </div>

    @if (_listView)
    {
        var active = ActiveOpponents;
        var current = active.ElementAtOrDefault(Math.Clamp(_listIndex, 0, Math.Max(active.Count - 1, 0)));
        @* swipe left/right (or the arrows) through the opponents still in the pairing *@
        <section class="listview" @ontouchstart="TouchStart" @ontouchend="TouchEnd">
            <div class="listnav">
                <button class="btn" aria-label="Vorherige Liste" disabled="@(active.Count < 2)" @onclick="() => MoveList(-1)">‹</button>
                <span class="dots">
                    @for (var i = 0; i < active.Count; i++)
                    {
                        var index = i;
                        <button class="dot @(index == _listIndex ? "on" : "") @(Remaining(active[index].Id, false) ? "" : "taken")"
                                aria-label="@active[index].Name" @onclick="() => _listIndex = index">
                            @active[index].ArmyShort
                        </button>
                    }
                </span>
                <button class="btn" aria-label="Nächste Liste" disabled="@(active.Count < 2)" @onclick="() => MoveList(1)">›</button>
            </div>
            @if (current is not null)
            {
                <div class="settle" @key="current.Id">
                    <ArmyList Player="current" Marks="MarksOf(current.Id)" Note="NoteOf(current.Id)"
                              MatchupNotes="MatchupNotesOf(current.Id)" Taken="@(!Remaining(current.Id, false))"
                              ShowNotes="_showNotes" OnToggleNotes="ToggleNotesAsync" />
                </div>
            }
        </section>
    }
    else
    {
    @* rebuilt (settle-in) only on flip; step changes transition cell by cell so you see what drops out *@
    <div class="matrix-wrap settle" @key="ShowAll">
        <table class="matrix pairing @(_enemyView ? "enemy-view" : "")">
            <thead>
            <tr>
                <th class="corner">
                    @* full matrix ↔ remaining players: expand / collapse arrows *@
                    <button class="flip @(ShowAll ? "on" : "")" @onclick="ToggleView" disabled="@Done"
                            title="@(ShowAll ? "Nur verbleibende Spieler" : "Ganze Matrix zeigen")"
                            aria-label="@(ShowAll ? "Nur verbleibende Spieler" : "Ganze Matrix zeigen")">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            @if (ShowAll)
                            {
                                @* four arrows pointing in: back to the remaining players *@
                                <path d="M3 3l6 6" /><path d="M9 4v5H4" />
                                <path d="M21 3l-6 6" /><path d="M15 4v5h5" />
                                <path d="M3 21l6-6" /><path d="M9 20v-5H4" />
                                <path d="M21 21l-6-6" /><path d="M15 20v-5h5" />
                            }
                            else
                            {
                                @* four arrows pointing out: the whole matrix *@
                                <path d="M9 9L3 3" /><path d="M3 8V3h5" />
                                <path d="M15 9l6-6" /><path d="M16 3h5v5" />
                                <path d="M9 15l-6 6" /><path d="M3 16v5h5" />
                                <path d="M15 15l6 6" /><path d="M21 16v5h-5" />
                            }
                        </svg>
                    </button>
                </th>
                @foreach (var opp in Columns)
                {
                    <th class="@HeaderClass(opp.Id, false)">
                        <button disabled="@(!CanPickDefender(opp.Id, false))" @onclick="() => PickDefenderAsync(opp.Id, false)">
                            <span class="army">@opp.ArmyShort</span>
                            <span class="player">@opp.Name</span>
                            @if (Tip(opp.Id, own: false) is { } tip)
                            {
                                <span class="tip them">@tip</span>
                            }
                        </button>
                    </th>
                }
            </tr>
            </thead>
            <tbody>
            @foreach (var own in Rows)
            {
                <tr>
                    <th class="row @HeaderClass(own.Id, true)">
                        <button disabled="@(!CanPickDefender(own.Id, true))" @onclick="() => PickDefenderAsync(own.Id, true)">
                            <span class="army">@own.ArmyShort</span>
                            <span class="player">@own.Name</span>
                            @if (Tip(own.Id, own: true) is { } tip)
                            {
                                <span class="tip @(IsBest(own.Id) ? "best" : "")">@tip</span>
                            }
                        </button>
                    </th>
                    @foreach (var opp in Columns)
                    {
                        var level = Shown(LevelAt(own.Id, opp.Id));
                        var css = CellClass(own.Id, opp.Id);
                        var round = PredictedRound(own.Id, opp.Id);
                        <td class="@css @AdviceCellClass(own.Id, opp.Id) @(round is null ? "" : $"path-{round}") @(_enemyView ? "enemy" : "")"
                            style="@(css is "cross" ? "" : $"background:{level?.Color ?? "#fff"}")"
                            @onclick="() => TapCell(own.Id, opp.Id)">
                            @level?.Label
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (AttackerLists is { Count: 2 } attackers)
    {
        @* their two attackers side by side – the lists that matter for the choice *@
        <section class="duo settle">
            <h2>Gegner-Attacker</h2>
            <div class="duo-grid">
                @foreach (var id in attackers)
                {
                    var player = Player(id);
                    <ArmyList Player="player" Marks="MarksOf(id)" Note="NoteOf(id)" MatchupNotes="MatchupNotesOf(id)"
                              ShowNotes="_showNotes" OnToggleNotes="ToggleNotesAsync" />
                }
            </div>
        </section>
    }
    }

    @if (_error is not null) { <p class="error">@_error</p> }

    @if (_showAdvice && !Done)
    {
        <section class="advice settle">
            @if (Advice is not { } a)
            {
                <p class="muted">@(_adviceLoading ? "Rechne…" : "Empfehlungen kommen, sobald einmal Netz da war.")</p>
            }
            else
            {
                <header>
                    <h2>Empfehlung</h2>
                </header>
                <div class="modes" role="radiogroup" aria-label="Modus">
                    @foreach (var (key, label) in Modes)
                    {
                        <button class="@(_mode == key ? "on" : "")" role="radio" aria-checked="@(_mode == key)"
                                disabled="@_busy" @onclick="() => SetModeAsync(key)">@label</button>
                    }
                </div>
                <p class="modehint">
                    @if (_mode == "avoidminus" && a.MinusFactors.Count > 0)
                    {
                        <span>Schlechte Matchups vermeiden:</span>
                        @foreach (var (f, i) in a.MinusFactors.Select((f, i) => (f, i)))
                        {
                            var level = _p.Scale.FirstOrDefault(l => l.Key == f.LevelKey);
                            <span class="chip-inline" style="background:@level?.Color">@level?.Label</span>
                            <span>zählt @Format.Factor(f.Factor)-fach@(i < a.MinusFactors.Count - 1 ? "," : ".")</span>
                        }
                    }
                    else
                    {
                        @ModeHint
                    }
                </p>
                <div class="picks">
                    @foreach (var (path, i) in a.TopPicks.Select((p, i) => (p, i)))
                    {
                        <button class="pick @(i == _pick ? "on" : "")" @onclick="() => SelectPickAsync(i)">
                            <span class="rank">@(i + 1)</span>
                            <span class="who">
                                @foreach (var id in path.Option.Players)
                                {
                                    var pl = Player(id);
                                    <span class="pl"><span class="army">@pl.ArmyShort</span> @pl.Name</span>
                                }
                            </span>
                            @* always real points – a mode's weighting only changes the order *@
                            <span class="nums">
                                <span class="final"><small>Gesamtwertung</small> <strong>@Format.Score(path.Final.Value)</strong> <em>@Format.Percent(path.Final.Probability)</em></span>
                                <span class="round">Diese Runde @Format.Score(path.ThisRound.Value) · @Format.Percent(path.ThisRound.Probability)</span>
                            </span>
                        </button>
                    }
                </div>
                @if (Preview is { } preview)
                {
                    <ol class="timeline">
                        @foreach (var round in preview.Steps.GroupBy(st => st.Round))
                        {
                            <li>
                                <span class="r path-@(round.Key - FirstPathRound + 1)">Runde @round.Key</span>
                                @foreach (var st in round)
                                {
                                    @if (st.Step == "choices")
                                    {
                                        <span class="st"><em>Wahl</em> wir: @Names(st.Own) · die: @Names(st.Opponent)</span>
                                    }
                                    else
                                    {
                                        <span class="st"><em>@StepLabel(st.Step)</em> @Names(st.Own) ↔ @Names(st.Opponent)</span>
                                    }
                                }
                                <div class="pgames">
                                    @foreach (var g in preview.Games.Where(g => g.Round == round.Key))
                                    {
                                        var own = Player(g.OwnPlayerId);
                                        var opp = Player(g.OpponentPlayerId);
                                        var level = Shown(LevelAt(g.OwnPlayerId, g.OpponentPlayerId));
                                        <span class="name own">@own.Name</span>
                                        <span class="army">@own.ArmyShort</span>
                                        <span class="rating @(_enemyView ? "enemy" : "")" style="background:@(level?.Color ?? "#e8ebf1")">@(level?.Label ?? "–")</span>
                                        <span class="army">@opp.ArmyShort</span>
                                        <span class="name">@opp.Name</span>
                                    }
                                </div>
                            </li>
                        }
                    </ol>
                    <p class="muted pathtotal">Gezeigter Verlauf endet bei <strong>@Format.Score(preview.Total)</strong></p>
                }
            }
        </section>
    }

    @if (_p.Games.Count > 0)
    {
        <section class="games">
            <h2>Matchups</h2>
            @foreach (var g in _p.Games)
            {
                var own = Player(g.OwnPlayerId);
                var opp = Player(g.OpponentPlayerId);
                var level = Shown(LevelAt(g.OwnPlayerId, g.OpponentPlayerId));
                <div class="gamerow @(_fresh.Contains(g.OwnPlayerId) ? "settle" : "")">
                    <span class="name own">@own.Name</span>
                    <span class="army">@own.ArmyShort</span>
                    <span class="rating @(_enemyView ? "enemy" : "")" style="background:@(level?.Color ?? "#e8ebf1")">@(level?.Label ?? "–")</span>
                    <span class="army">@opp.ArmyShort</span>
                    <span class="name opp">@opp.Name</span>
                </div>
            }
        </section>
    }


}

@code {
    [Parameter] public string Token { get; set; } = "";
    [Parameter] public Guid OpponentId { get; set; }

    private const int LeaveMillis = 220; // = --motion in app.css

    private const string AdviceKey = "advice";
    private const string ModeKey = "adviceMode";

    private static readonly (string Key, string Label)[] Modes =
        [("optimal", "Optimal"), ("avoidminus", "Minus vermeiden")];

    private PairingDto? _p;
    private LocalPairing? _local;
    private PairingAdviceDto? _advice;
    private bool _adviceLoading;
    private int _adviceRun;
    private Timer? _poll;
    private bool _showAdvice;   // recommendations: off by default, remembered per device
    private int _pick;          // which top pick's path is previewed
    private string _mode = "optimal";

    private bool _showAll;
    private bool _enemyView;    // show the matrix as the opponent sees it (ratings mirrored)
    private bool _listView;     // lists instead of the matrix
    private int _listIndex;
    private double? _touchX;
    private bool _showNotes = true;   // notes in the lists, remembered per device
    private const string NotesKey = "listNotes";
    private bool _busy;
    private string? _error;
    private HashSet<Guid> _leaving = [];
    private HashSet<Guid> _fresh = [];   // own players of the games added by the last step (highlighted)

    // local picks of the current step (not saved until the step is entered)
    private Guid? _ownDefender;
    private Guid? _oppDefender;
    private List<Guid> _ownAttackers = [];
    private List<Guid> _oppAttackers = [];
    private Guid? _ownAccepts;   // their attacker we take
    private Guid? _oppAccepts;   // our attacker they take

    private bool Done => _p!.Step == "done";
    private bool ShowAll => _showAll || Done;
    private bool HasLocalPick => _ownDefender is not null || _oppDefender is not null || _ownAttackers.Count > 0
                                 || _oppAttackers.Count > 0 || _ownAccepts is not null || _oppAccepts is not null;

    private IEnumerable<PlayerDto> Rows => _p!.Own.Players.Where(p => ShowAll || Remaining(p.Id, true) || _leaving.Contains(p.Id));
    private IEnumerable<PlayerDto> Columns => _p!.Opponent.Players.Where(p => ShowAll || Remaining(p.Id, false) || _leaving.Contains(p.Id));

    private bool Remaining(Guid id, bool own) => (own ? _p!.RemainingOwn : _p!.RemainingOpponent).Contains(id);
    private Guid? OwnDef => _p!.OwnDefender ?? _ownDefender;
    private Guid? OppDef => _p!.OpponentDefender ?? _oppDefender;

    private string TotalClass => _p!.FixedScore > 0 ? "pos" : _p.FixedScore < 0 ? "neg" : "";

    private PlayerDto Player(Guid id) => _p!.Own.Players.Concat(_p.Opponent.Players).First(p => p.Id == id);


    protected override async Task OnParametersSetAsync()
    {
        _showAdvice = await Prefs.GetAsync(AdviceKey);
        _showNotes = await Prefs.GetAsync(NotesKey, fallback: true);
        var stored = await Prefs.GetStringAsync(ModeKey);
        _mode = stored is "avoidminus" ? stored : "optimal";

        _local = new LocalPairing(Api, Prefs, Token, OpponentId);
        _local.Changed += OnLocalChanged;
        try
        {
            await _local.LoadAsync();
            _p = _local.View;
        }
        catch (ApiException e) { _error = e.Message; return; }

        if (!_p.CanEdit) // viewers follow the captain now and then
            _poll = new Timer(_ => _ = InvokeAsync(async () => await _local.RefreshAsync()), null, 15_000, 15_000);
        // Entering the pairing: compute once. With a fully rated matrix, load the round values of every mode and
        // the recommendations for this state in every mode (also with the eye off) – afterwards no network is needed.
        if (_p.UnratedCells == 0) _ = PrecomputeAsync();
        else _ = RecomputeAdviceAsync();
    }

    private void OnLocalChanged() => _ = InvokeAsync(() =>
    {
        var moved = _p is not null && !_p.Moves.SequenceEqual(_local!.View.Moves);
        _p = _local!.View;
        if (moved) { ResetPicks(); _ = RecomputeAdviceAsync(); }
        StateHasChanged();
    });

    public void Dispose()
    {
        _poll?.Dispose();
        if (_local is not null) _local.Changed -= OnLocalChanged;
    }

    private string SyncText => _local!.Status switch
    {
        SyncStatus.Pending => "Noch nicht gespeichert – wird gesendet, sobald Netz da ist.",
        SyncStatus.Offline => "Offline – du arbeitest mit dem Stand auf diesem Gerät.",
        _ => "Gespeichert",
    };

    // ---------- interaction ----------

    private bool CanPickDefender(Guid id, bool own) =>
        _p!.CanEdit && !_busy && Remaining(id, own) &&
        (_p.Step == "defenders" || _p.Step == "attackers" && (own ? _p.OwnDefender : _p.OpponentDefender) == id);

    private async Task PickDefenderAsync(Guid id, bool own)
    {
        if (!CanPickDefender(id, own)) return;

        if (_p!.Step == "attackers")
        {
            // defenders are already saved: take them back, keep the other one picked
            var keepOwn = own ? null : _p.OwnDefender;
            var keepOpp = own ? _p.OpponentDefender : null;
            await ChangeAsync(() => _local!.UndoAsync());
            _ownDefender = keepOwn;
            _oppDefender = keepOpp;
            return;
        }

        if (own) _ownDefender = _ownDefender == id ? null : id;
        else _oppDefender = _oppDefender == id ? null : id;
        SyncPickFromMatrix();

        if (_ownDefender is { } d && _oppDefender is { } e)
            await AutoSubmitAsync(new PairingMoveDto("defenders", [d], [e]));
    }

    private async Task TapCell(Guid own, Guid opp)
    {
        if (!_p!.CanEdit || _busy) return;
        var d = _p.OwnDefender;
        var e = _p.OpponentDefender;
        if (own == d && opp == e) return; // the two defenders never meet

        switch (_p.Step)
        {
            case "attackers" when own == d && Remaining(opp, false):
                Toggle(_oppAttackers, opp);
                break;
            case "attackers" when opp == e && Remaining(own, true):
                Toggle(_ownAttackers, own);
                break;
            case "choices" when own == d && _p.OpponentAttackers.Contains(opp):
                _ownAccepts = opp;
                break;
            case "choices" when opp == e && _p.OwnAttackers.Contains(own):
                _oppAccepts = own;
                break;
        }

        SyncPickFromMatrix();

        // complete step → enter it automatically (wrong tap? Undo)
        if (_p.Step == "attackers" && _ownAttackers.Count == 2 && _oppAttackers.Count == 2)
            await AutoSubmitAsync(new PairingMoveDto("attackers", _ownAttackers.ToList(), _oppAttackers.ToList()));
        else if (_p.Step == "choices" && _ownAccepts is { } take && _oppAccepts is { } taken)
            await AutoSubmitAsync(new PairingMoveDto("choices", [take], [taken]));
    }

    /// <summary>Shows the last tap for a moment, then enters the step – locally, no network needed.</summary>
    private async Task AutoSubmitAsync(PairingMoveDto move)
    {
        _busy = true;
        StateHasChanged();
        await Task.Delay(LeaveMillis);
        await ChangeAsync(() => _local!.ApplyAsync(move));
    }

    // ---------- lists during the pairing ----------

    /// <summary>Opponents still in the pairing; with the matrix expanded (or the pairing done) all of them.</summary>
    private List<PlayerDto> ActiveOpponents =>
        _p!.Opponent.Players.Where(p => ShowAll || Remaining(p.Id, false)).ToList();

    /// <summary>Their two attackers: once tapped in the attackers step, and in the choice step.</summary>
    private IReadOnlyList<Guid>? AttackerLists => _p!.Step switch
    {
        "attackers" when _oppAttackers.Count == 2 => _oppAttackers,
        "choices" => _p.OpponentAttackers,
        _ => null,
    };

    private IReadOnlyList<ListMarkDto> MarksOf(Guid id) => (_p!.ListMarks ?? []).Where(m => m.PlayerId == id).ToList();
    private NoteDto? NoteOf(Guid id) => (_p!.PlayerNotes ?? []).FirstOrDefault(n => n.PlayerId == id)?.Note;

    /// <summary>Notes from the matrix on this opponent's matchups, labelled with our player.</summary>
    private IReadOnlyList<(string Against, NoteDto Note)> MatchupNotesOf(Guid opponentId) =>
        (_p!.CellNotes ?? []).Where(n => n.OpponentPlayerId == opponentId)
            .Select(n => (Player(n.OwnPlayerId).Name, n.Note)).ToList();

    private async Task ToggleNotesAsync()
    {
        _showNotes = !_showNotes;
        await Prefs.SetAsync(NotesKey, _showNotes);
    }

    /// <summary>Starts at their defender (or the one being picked), otherwise at the first active opponent.</summary>
    private void ShowLists()
    {
        var active = ActiveOpponents;
        var start = OppDef is { } d ? active.FindIndex(p => p.Id == d) : -1;
        _listIndex = Math.Max(start, 0);
        _listView = true;
    }

    private void MoveList(int delta)
    {
        var count = ActiveOpponents.Count;
        if (count == 0) return;
        _listIndex = ((_listIndex + delta) % count + count) % count;
    }

    private void TouchStart(TouchEventArgs e) => _touchX = e.ChangedTouches.FirstOrDefault()?.ClientX;

    private void TouchEnd(TouchEventArgs e)
    {
        if (_touchX is not { } start || e.ChangedTouches.FirstOrDefault() is not { } end) return;
        var dx = end.ClientX - start;
        _touchX = null;
        if (Math.Abs(dx) < 50) return; // a tap or a scroll, not a swipe
        MoveList(dx < 0 ? 1 : -1);
    }

    /// <summary>Tapping a recommendation selects it in the matrix as well (our side of the current step).</summary>
    private async Task SelectPickAsync(int index)
    {
        _pick = index;
        if (!_p!.CanEdit || _busy || Advice?.TopPicks.ElementAtOrDefault(index) is not { } pick) return;
        var players = pick.Option.Players;
        switch (_p.Step)
        {
            case "defenders":
                _ownDefender = players[0];
                if (_oppDefender is { } e)
                    await AutoSubmitAsync(new PairingMoveDto("defenders", [players[0]], [e]));
                break;
            case "attackers":
                _ownAttackers = players.ToList();
                if (_oppAttackers.Count == 2)
                    await AutoSubmitAsync(new PairingMoveDto("attackers", _ownAttackers.ToList(), _oppAttackers.ToList()));
                break;
            case "choices":
                _ownAccepts = players[0];
                if (_oppAccepts is { } taken)
                    await AutoSubmitAsync(new PairingMoveDto("choices", [players[0]], [taken]));
                break;
        }
    }

    /// <summary>The other way round: picking in the matrix shows the matching recommendation's path.</summary>
    private void SyncPickFromMatrix()
    {
        if (Advice is not { } a) return;
        IReadOnlyList<Guid>? own = _p!.Step switch
        {
            "defenders" when _ownDefender is { } d => [d],
            "attackers" when _ownAttackers.Count == 2 => _ownAttackers,
            "choices" when _ownAccepts is { } q => [q],
            _ => null,
        };
        if (own is null) return;
        var index = a.TopPicks.ToList().FindIndex(p => p.Option.Players.OrderBy(x => x).SequenceEqual(own.OrderBy(x => x)));
        if (index >= 0) _pick = index;
    }

    private static void Toggle(List<Guid> picks, Guid id)
    {
        if (!picks.Remove(id)) picks.Add(id);
        if (picks.Count > 2) picks.RemoveAt(0);
    }

    private void ToggleView() => _showAll = !_showAll;

    private async Task ToggleAdviceAsync()
    {
        _showAdvice = !_showAdvice;
        await Prefs.SetAsync(AdviceKey, _showAdvice);
        await RecomputeAdviceAsync();
    }

    private async Task SetModeAsync(string mode)
    {
        if (_mode == mode) return;
        _mode = mode;
        await Prefs.SetStringAsync(ModeKey, mode);
        await RecomputeAdviceAsync();
    }

    private async Task PrecomputeAsync()
    {
        await _local!.PreloadAsync();
        if (_showAdvice) await RecomputeAdviceAsync();
        else foreach (var mode in LocalPairing.Modes) await _local.AdviseAsync(mode);
    }

    /// <summary>
    /// Recommendations are computed on the device (shared domain advisor) – no network after the first load.
    /// Cached per mode and state; after the shown mode, the other modes are computed in the background.
    /// </summary>
    private async Task RecomputeAdviceAsync()
    {
        if (!_showAdvice || _local is null) return;
        var run = ++_adviceRun;
        _pick = 0;
        if (_local.TryCached(_mode, out var cached))
        {
            _advice = cached;
            _adviceLoading = false;
        }
        else
        {
            _adviceLoading = true;
            _advice = null;
            StateHasChanged();
            var advice = await _local.AdviseAsync(_mode);
            if (run != _adviceRun) return; // a newer state came in meanwhile
            _advice = advice;
            _adviceLoading = false;
        }
        StateHasChanged();

        // other modes for the same state, while the captain looks at the matrix
        await Task.Delay(400);
        foreach (var mode in LocalPairing.Modes.Where(m => m != _mode))
        {
            if (run != _adviceRun) return;
            await _local.AdviseAsync(mode);
        }
    }

    // ---------- recommendations ----------

    private PairingAdviceDto? Advice => _showAdvice ? _advice : null;
    private PredictedPathDto? Preview => Advice?.TopPicks.ElementAtOrDefault(_pick);

    /// <summary>How likely a player is used in the current step (sum over options containing him).</summary>
    private string? Tip(Guid id, bool own)
    {
        if (Advice is not { } a) return null;
        var p = (own ? a.Own : a.Opponent).Where(o => o.Players.Contains(id)).Sum(o => o.Probability);
        if (p < 0.005) return null;
        return (own && IsBest(id) ? "★ " : "") + Format.Percent(p);
    }

    private bool IsBest(Guid id) => Advice?.Own.FirstOrDefault()?.Players.Contains(id) == true;

    /// <summary>Attackers/choices: ring the cells of our best option.</summary>
    private string AdviceCellClass(Guid own, Guid opp)
    {
        if (Advice?.Own.FirstOrDefault() is not { } best) return "";
        return _p!.Step switch
        {
            "attackers" when opp == _p.OpponentDefender && best.Players.Contains(own) => "rec",
            "choices" when own == _p.OwnDefender && best.Players.Contains(opp) => "rec",
            _ => "",
        };
    }

    /// <summary>1 = next round (dark corner), 2 = the one after (mid), 3 = third (light) – same corner on the timeline labels.</summary>
    private int? PredictedRound(Guid own, Guid opp) =>
        Preview?.Games.FirstOrDefault(g => g.OwnPlayerId == own && g.OpponentPlayerId == opp)?.Round is { } r
            ? r - FirstPathRound + 1
            : null;

    private int FirstPathRound => Preview?.Steps.FirstOrDefault()?.Round ?? _p!.Round;

    private string ModeHint => _mode switch
    {
        "avoidminus" => "Schlechte Matchups vermeiden: Minus-Matchups zählen in der Entscheidung stärker.",
        _ => "Bester Durchschnitt: Plus und Minus zählen gleich, der Gegner spielt ebenfalls optimal.",
    };

    private static string StepLabel(string step) => step switch
    {
        "defenders" => "D",
        "attackers" => "A",
        _ => "Wahl",
    };

    private string Names(IReadOnlyList<Guid> ids) => string.Join(" + ", ids.Select(id => Player(id).Name));

    private async Task UndoAsync()
    {
        if (HasLocalPick) { ResetPicks(); return; } // first undo clears unsaved taps
        await ChangeAsync(() => _local!.UndoAsync());
    }


    /// <summary>Applies a local change and animates players that leave the matrix.</summary>
    private async Task ChangeAsync(Func<Task> change)
    {
        _busy = true;
        _error = null;
        try
        {
            var before = _p!;
            await change();
            var next = _local!.View;
            // let paired players fade out before the matrix shrinks
            _leaving = before.RemainingOwn.Concat(before.RemainingOpponent)
                .Except(next.RemainingOwn.Concat(next.RemainingOpponent)).ToHashSet();
            if (_leaving.Count > 0 && !ShowAll)
            {
                StateHasChanged();
                await Task.Delay(LeaveMillis);
            }
            _leaving = [];
            _fresh = next.Games.Select(g => g.OwnPlayerId).Except(before.Games.Select(g => g.OwnPlayerId)).ToHashSet();
            _p = next;
            ResetPicks();
            _ = RecomputeAdviceAsync();
        }
        catch (DomainException e) { _error = e.Message; }
        finally { _busy = false; }
    }

    private void ResetPicks()
    {
        _ownDefender = _oppDefender = null;
        _ownAttackers = [];
        _oppAttackers = [];
        _ownAccepts = _oppAccepts = null;
    }

    // ---------- rendering ----------

    private string HeaderClass(Guid id, bool own)
    {
        if (_leaving.Contains(id)) return "leaving";
        if (!Remaining(id, own)) return "taken";
        if ((own ? OwnDef : OppDef) == id) return "def";
        var attackers = own ? (_p!.OwnAttackers.Count > 0 ? _p.OwnAttackers : _ownAttackers)
                            : (_p!.OpponentAttackers.Count > 0 ? _p.OpponentAttackers : _oppAttackers);
        return attackers.Contains(id) ? "att" : "";
    }

    private string CellClass(Guid own, Guid opp)
    {
        if (_leaving.Contains(own) || _leaving.Contains(opp)) return "leaving";
        if (IsGame(own, opp)) return "game";
        if (!Remaining(own, true) || !Remaining(opp, false)) return "taken";

        var d = OwnDef;
        var e = OppDef;
        switch (_p!.Step)
        {
            case "defenders":
                return own == d || opp == e ? "focus" : "";
            case "attackers":
                if (own == d && opp == e) return "cross";
                if (own == d) return _oppAttackers.Contains(opp) ? "pick tap" : "tap";
                if (opp == e) return _ownAttackers.Contains(own) ? "pick tap" : "tap";
                return "dim";
            case "choices":
                if (own == d && opp == e) return "cross";
                if (own == d && _p.OpponentAttackers.Contains(opp)) return _ownAccepts == opp ? "pick tap" : "tap";
                if (opp == e && _p.OwnAttackers.Contains(own)) return _oppAccepts == own ? "pick tap" : "tap";
                return "dim";
            default:
                return "";
        }
    }

    private bool IsGame(Guid own, Guid opp) => _p!.Games.Any(g => g.OwnPlayerId == own && g.OpponentPlayerId == opp);

    /// <summary>In the opponent's view a rating becomes its mirror on the scale (+ ↔ -, 0/+ ↔ 0/-).</summary>
    private RatingLevelDto? Shown(RatingLevelDto? level)
    {
        if (!_enemyView || level is null) return level;
        return _p!.Scale.OrderBy(l => Math.Abs(l.Score + level.Score)).First();
    }

    private RatingLevelDto? LevelAt(Guid own, Guid opp)
    {
        var cell = _p!.Cells.FirstOrDefault(c => c.OwnPlayerId == own && c.OpponentPlayerId == opp);
        return cell is null ? null : _p.Scale.FirstOrDefault(l => l.Key == cell.LevelKey);
    }
}
