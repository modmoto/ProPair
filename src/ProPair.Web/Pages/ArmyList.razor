@* Read-only army list for the pairing: line marks, and – switchable – all notes (line notes, list note, matchup notes). *@

<div class="armylist-ro">
    @if (ShowHeader)
    {
        <header>
            <span class="army">@Player.ArmyShort</span>
            <strong>@Player.Name</strong>
            <span class="muted">@Player.ArmyName@(Taken ? " (gepickt)" : "")</span>
            @if (OnToggleNotes.HasDelegate && HasNotes)
            {
                <button class="notes-toggle @(ShowNotes ? "on" : "")" @onclick="OnToggleNotes"
                        title="@(ShowNotes ? "Notizen verstecken" : "Notizen anzeigen")"
                        aria-label="@(ShowNotes ? "Notizen verstecken" : "Notizen anzeigen")" aria-pressed="@ShowNotes">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1h-9l-5 4v-4H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z" />
                        @if (!ShowNotes)
                        {
                            <path d="M3 3l18 18" />
                        }
                    </svg>
                </button>
            }
        </header>
    }
    <div class="armylist">
        @foreach (var (line, index) in Player.ListText.Split('\n').Select((l, i) => (l, i)))
        {
            var mark = Marks.FirstOrDefault(m => m.LineIndex == index);
            @* hiding notes also hides the mark colours: a plain list *@
            <div class="listline @(mark is null || !ShowNotes ? "" : $"mark-{mark.Color}")">
                <span class="text">@line</span>
                @if (ShowNotes && !string.IsNullOrEmpty(mark?.Note))
                {
                    <span class="marknote">@mark.Note</span>
                }
            </div>
        }
    </div>
    @if (ShowNotes && (Note is not null || MatchupNotes.Count > 0))
    {
        <div class="ro-notes">
            @if (Note is not null)
            {
                <p class="note-text">@Note.Text</p>
            }
            @foreach (var (against, note) in MatchupNotes)
            {
                <p class="note-text matchup"><span class="muted">gegen @against:</span> @note.Text</p>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public PlayerDto Player { get; set; } = default!;
    [Parameter] public IReadOnlyList<ListMarkDto> Marks { get; set; } = [];
    [Parameter] public NoteDto? Note { get; set; }

    /// <summary>Notes on matchups with this player: (name of the other player, note).</summary>
    [Parameter] public IReadOnlyList<(string Against, NoteDto Note)> MatchupNotes { get; set; } = [];

    [Parameter] public bool ShowHeader { get; set; } = true;
    [Parameter] public bool ShowNotes { get; set; } = true;
    [Parameter] public EventCallback OnToggleNotes { get; set; }

    /// <summary>Already paired: shown with "(gepickt)" behind the army.</summary>
    [Parameter] public bool Taken { get; set; }

    private bool HasNotes => Note is not null || MatchupNotes.Count > 0 || Marks.Count > 0;
}
